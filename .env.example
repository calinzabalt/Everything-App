# Copy this file to `.env` and fill in the values.

DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/everything_app"

AUTH_SECRET="generate-a-long-random-string"
AUTH_USERNAME="your-username"
AUTH_PASSWORD="your-strong-password"

INGEST_TOKEN="generate-a-long-random-token"

BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="your-brevo-smtp-login"
BREVO_SMTP_PASS="your-brevo-smtp-key"
CONTACT_FROM_EMAIL="hello@sienaworks.com"
CONTACT_TO_EMAIL="hello@sienaworks.com"
